title: Return card to hand.
view-if: difficulty <= 0 and last_advisor_action = 0 and last_cabinet_action = 0
go-to: root
on-arrival: {!
if (Q.month_actions > 0) {
    Q.month_actions -= 1;
}
// return card to hand
var card = this.state.lastPlayedCard;
if (card) {
    card.image = card.cardImage;
    if (Q.difficulty >= 0) {
        this.state.currentHands['main'].push(card);
    } else {
        this.state.currentHands['main.main_easy'].push(card);
    }
}

var prevScene = this.game.scenes[this.state.prevTopSceneId];
if (prevScene && Q[prevScene.id + "_timer"] !== undefined) {
    Q[prevScene.id + "_timer"] = 0;
}

if (this.state.visits[prevScene ? prevScene.id : (card ? card.id : null)]) {
    this.state.visits[prevScene ? prevScene.id : card.id] -= 1;
}
!}