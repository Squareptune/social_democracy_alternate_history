title: Return card to hand.
view-if: difficulty <= 0 and last_advisor_action = 0 and last_cabinet_action = 0
go-to: root
on-arrival: {!
if (Q.month_actions > 0) {
    Q.month_actions -= 1;
}
// return card to hand
var card = this.state.lastPlayedCard;
card.image = card.cardImage;
if (Q.difficulty >= 0) {
    this.state.currentHands['main'].push(card);
} else {
    this.state.currentHands['main.main_easy'].push(card);
}

var timerOverrides = {
    "Civil_Rights": "civil_rights_timer",
    "Interior_policy": "interior_policy_timer",
    "War_Effort": "war_room_timer",
    "economic_policy": "monetary_policy_timer",
    "post_policy": "postmaster_policy_timer"
};

var timerVar = timerOverrides[card.id];

if (!timerVar) {
    var standardKey = card.id + "_timer";
    if (Q.hasOwnProperty(standardKey)) {
        timerVar = standardKey;
    } else {
        var lowerTarget = standardKey.toLowerCase();
        for (var key in Q) {
            if (key.toLowerCase() === lowerTarget) {
                timerVar = key;
                break;
            }
        }
    }
}
if (timerVar && Q[timerVar]) {
    Q[timerVar] = 0;
}
// reduce visit count
if (this.state.visits[card.id]) {
    this.state.visits[card.id] -= 1;
}
!}