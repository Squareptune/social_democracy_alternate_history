    {!</td>!}
    {!<td class="achievement-info-locked">!}
        <div class="achievement-title-locked">
            Carpetbagger Supreme
        </div>
        <div class="achievement-description-locked">
            Successfully readmit every Southern state before the historical schedule.
        </div>
    {!</td>!}
{!</tr>!}
?]

[? if not achievement_liberty_place_victory: 
