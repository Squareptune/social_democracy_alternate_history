        <img src="img/Achievements/Liberty_Place_Victory.png" alt="Victory at Liberty Place Icon">
    {!</td>!}
    {!<td class="achievement-info-locked">!}
        <div class="achievement-title-locked">
            Victory at Liberty Place
        </div>
        <div class="achievement-description-locked">
            Win at Liberty Place without federal intervention.
        </div>
    {!</td>!}
{!</tr>!}
?]

[? if not achievement_pro_re_publica: 
{!<tr class="achievement">!}
    {!<td class="achievement-icon-locked">!}
        <img src="img/Achievements/Pro_Re_Publica.png" alt="Pro Re Publica! Icon">
    {!</td>!}
    {!<td class="achievement-info-locked">!}
        <div class="achievement-title-locked">
            Pro Re Publica!
        </div>
        <div class="achievement-description-locked">
            Finish the game with maximum Army loyalty and Navy loyalty.
        </div>
    {!</td>!}
{!</tr>!}
?]

[? if not achievement_three_purple_hearts: 
{!<tr class="achievement">!}
    {!<td class="achievement-icon-locked">!}
        <img src="img/Achievements/Three_Purple_Hearts.png" alt="Three Purple Hearts Icon">
    {!</td>!}
    {!<td class="achievement-info-locked">!}
        <div class="achievement-title-locked">
