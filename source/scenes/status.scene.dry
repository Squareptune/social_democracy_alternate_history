[? if president = "Greeley": <img src="img/portraits/500px-Horace_Greeley_restored.jpg" style="outline: 3px solid #DAA520; display: block; margin: 0 auto; width: 75%;"> ?]
[? if president = "Brown": <img src="img/portraits/BGratzBrown.png" style="outline: 3px solid #DAA520; display: block; margin: 0 auto; width: 75%;"> ?]
[? if president = "Morton": <div class="Panel-img"><img src="img/portraits/Oliver_Hazard_Perry_Morton.jpg"></div> ?]
[? if president = "Hayes": <div class="Panel-img"><img src="img/portraits/Rutherford_Hayes.jpg"></div> ?]
[? if president = "Tilden": <img src="img/portraits/Samuel_Tilden._Portrait_of_the_American_politician,_who_served_as_the_25th_Governor_of_New_York,_Samuel_Jones_Tilden_(1814-1886),_by_José_María_Mora,_c._1870.jpg" style="outline: 3px solid #161d99; display: block; margin: 0 auto; width: 75%;"> ?]
[? if president = "Hendricks": <img src="img/portraits/Thomas_Andrews_Hendricks,_photo_portrait_seated,_1860-65.jpg" style="outline: 3px solid #161d99; display: block; margin: 0 auto; width: 75%;"> ?]
[? if president = "Allen": <img src="img/portraits/William_Allen_governor_-_Brady-Handy.jpg" style="outline: 3px solid #161d99; display: block; margin: 0 auto; width: 75%;"> ?]

Speaker of House: [+ speaker +] ([+ speaker_party +])

= Congress composition

House of Representatives:

{!<svg id="house_chart" style="width: 100%; display: block;"></svg>
<script>
(function() {
    if (typeof d3 === 'undefined' || !d3.parliament || !window._houseData || window._houseData.length === 0) return;
    var el = document.getElementById('house_chart');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 500;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.5));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.5)).innerRadiusCoef(0.4);
    // No animation - instant redraw every time
    parl.enter.smallToBig = false;
    parl.enter.fromCenter = false;
    parl.exit.toCenter = false;
    parl.exit.bigToSmall = false;
    parl.update.animate = false;
    d3.select('#house_chart').datum(window._houseData).call(parl);
})();
</script>!}

<span class="tooltip-text" title="Republican Party" style="color: #c00000;">**Republicans**</span>: [+ rep_r +] seats
<span class="tooltip-text" title="Democratic Party" style="color: #0015bc;">**Democrats**</span>: [+ dem_r +] seats
[? if liberal_split = 1 : <span class="tooltip-text" title="Liberal Republican Party" style="color: #DAA520;">**Lib Republicans**</span>: [+ lib_r +] seats, ?]
<span class="tooltip-text" title="Other" style="color: #00cc00;">**Other**</span>: [+ other_r +] seats

Senate Seats:

{!<svg id="senate_chart" style="width: 100%; display: block;"></svg>
<script>
(function() {
    if (typeof d3 === 'undefined' || !d3.parliament || !window._senateData || window._senateData.length === 0) return;
    var el = document.getElementById('senate_chart');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 500;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.5));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.5)).innerRadiusCoef(0.4);
    parl.enter.smallToBig = false;
    parl.enter.fromCenter = false;
    parl.exit.toCenter = false;
    parl.exit.bigToSmall = false;
    parl.update.animate = false;
    d3.select('#senate_chart').datum(window._senateData).call(parl);
})();
</script>!}

