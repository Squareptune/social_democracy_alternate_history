title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}

function _addP(list, id, legend, color, outline, seats) {
    if (seats && seats > 0) list.push({ id: id, legend: legend, name: legend, color: color, outline: outline, seats: Math.floor(seats) });
}

var _house = [];
_addP(_house, 'rep', 'Republican', '#B22222', '#600000', Q.rep_r);
_addP(_house, 'dem', 'Democrat', '#003366', '#001933', Q.dem_r);
_addP(_house, 'other', 'Other', '#AAAAAA', '#666666', Q.other_r);
_addP(_house, 'lib', 'Liberal Republican', '#DAA520', '#866614', Q.lib_r);
window._houseData = _house;

var _senate = [];
_addP(_senate, 'rep', 'Republican', '#B22222', '#600000', Q.rep_senate_r);
_addP(_senate, 'dem', 'Democrat', '#003366', '#001933', Q.dem_senate_r);
_addP(_senate, 'other', 'Other', '#AAAAAA', '#666666', Q.other_senate_r);
_addP(_senate, 'lib', 'Liberal Republican', '#DAA520', '#866614', Q.lib_senate_r);
window._senateData = _senate;
!}
= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

<span style="color: #c00000;">**Republican**</span> position: [? if rep_majority = 1 : Majority government ?][? if rep_majority != 1 : Out of Government ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [+ president +] ([+ president_party +])

[? if president = "Lincoln": <div class="Panel-img"><img src="img/portraits/Abraham_Lincoln_O-116_by_Gardner,_1865-crop.png"></div> ?]
[? if president = "Johnson": <div class="Panel-img"><img src="img/portraits/Johnson.jpg"></div> ?]
