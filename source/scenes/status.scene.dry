[? if president = "Bayard": <img src="img/portraits/960px-Thomas_F._Bayard,_Brady-Handy_photo_portrait,_circa_1870-1880_(cropped)(b).jpg" style="outline: 3px solid #161d99; display: block; margin: 0 auto; width: 75%;"> ?]
