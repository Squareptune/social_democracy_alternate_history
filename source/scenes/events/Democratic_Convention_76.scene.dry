title: 1876 <span style="color: #0015bc;">**Democratic Party**</span> National Convention
subtitle: Redeemers or Reformers?
tags: event
view-if: year = 1876 and month = 7
max-visits: 1
face-image: img/1876_Democratic_National_Convention_-_Missouri.jpg

= Democratic National Convention, 1876

The <span style="color: #0015bc;">**Democratic Party**</span> gathers in St. Louis divided over what the party should become.

The <span style="color: #4682B4;">**Northern Democrats**</span> want to run on reform, hard money and an end to corruption, led by New York Governor Samuel J. Tilden and his reputation for breaking the Tweed Ring.

The <span style="color: #002765;">**Bourbon Democrats**</span>, strongest in the South and among the soft-money men of the Midwest, want "home rule" and an end to Reconstruction. To them, Redemption remains the central issue.

[? if dem_reform_strength > dem_bourbon_strength : The reform wing arrives with real momentum, though the Bourbons still control many Southern delegations. ?]
[? if dem_bourbon_strength >= dem_reform_strength : The Bourbon wing enters the convention in a strong position, though the reformers have enough delegates to make their presence felt. ?]

- @dem_convention_decision_76: See what the convention decides...

@dem_convention_decision_76
on-arrival: {!

let reformFloor = Q.dem_reform_strength || 0;
reformFloor -= (Q.dem_reform_dissent || 0) * 0.5;
reformFloor += (Math.random() * 20) - 10;

let bourbonFloor = Q.dem_bourbon_strength || 0;
bourbonFloor -= (Q.dem_bourbon_dissent || 0) * 0.5;
bourbonFloor += (Math.random() * 20) - 10;

let demNationalSupport = (Q.workers_dem + Q.middle_class_dem + Q.rural_dem + Q.immigrant_laborers_dem + Q.unemployed_dem) / 5;

if (demNationalSupport < 45) {
    reformFloor += 20;
} else {
    bourbonFloor += 15;
}

Q.dem_reform_dominant_76 = (reformFloor > bourbonFloor) ? 1 : 0;

if (Q.dem_reform_dominant_76 === 1) {
    Q.dem_candidate_1876 = "Tilden";
    Q.dem_vp_candidate_1876 = "Hendricks";

    Q.dem_reform_strength += 6;
    Q.dem_reform_dissent -= 4;
    Q.dem_bourbon_dissent += 8;

    Q.dem_relation += 3;
    Q.middle_class_dem += 5;
    Q.workers_dem += 2;
    Q.rural_dem -= 2;
    Q.immigrant_laborers_dem += 2;

    Q.NY_workers_dem += 10;
    Q.NY_rural_dem += 10;
    Q.NY_immigrant_laborers_dem += 10;
    Q.NY_unemployed_dem += 10;

    Q.whiteL_militancy -= 0.02;

} else {
    let weights = {
        "Hendricks": 45 + (Math.random() * 20),
        "Bayard":    30 + (Math.random() * 20),
        "Hancock":   30 + (Math.random() * 20),
        "Allen":     20 + (Math.random() * 20),
    };

    if ((Q.unemployed || 0) > 8) weights["Allen"] += 15;
    if ((Q.inflation || 0) < 0) weights["Allen"] += 10;

    let repStrength = (Q.rep_r || 0) / ((Q.total_house_seats || 293) / 100);
    if (repStrength >= 55) weights["Hancock"] += 15;

    if ((Q.kkk_strength || 0) + (Q.whiteL_strength || 0) >= 400) weights["Bayard"] += 15;

    let totalWeight = Object.values(weights).reduce((a, b) => a + b, 0);
    let roll = Math.random() * totalWeight;
    let cumulative = 0;
    let chosen = "Hendricks";
    for (let [candidate, weight] of Object.entries(weights)) {
        cumulative += weight;
        if (roll <= cumulative) {
            chosen = candidate;
            break;
        }
    }

    Q.dem_candidate_1876 = chosen;
    Q.dem_bourbon_strength += 6;
    Q.dem_bourbon_dissent -= 4;
    Q.dem_reform_dissent += 8;
    Q.dem_relation += 2;

    Q.whiteL_militancy += 0.03;
    Q.kkk_militancy += 0.02;

    if (chosen === "Hendricks") {
        Q.dem_vp_candidate_1876 = "Hampton";
        Q.rural_dem += 4;
        Q.workers_dem += 3;
        Q.inflation += 0.15;
        Q.middle_class_dem -= 2;
    }
    else if (chosen === "Bayard") {
        Q.dem_vp_candidate_1876 = "Hampton";
        Q.rural_dem += 5;
        Q.middle_class_dem += 4;
        Q.workers_dem -= 2;
        Q.DE_rural_dem += 5;
        Q.MD_rural_dem += 4;
        Q.MO_rural_dem += 3;
    }
    else if (chosen === "Hancock") {
        Q.dem_vp_candidate_1876 = "English";
        Q.workers_dem += 4;
        Q.rural_dem += 5;
        Q.middle_class_dem += 3;
        Q.immigrant_laborers_dem += 3;
        Q.workers_rep -= 2;
        Q.rural_rep -= 2;
    }
    else if (chosen === "Allen") {
        Q.dem_vp_candidate_1876 = "Hampton";
        Q.workers_dem += 6;
        Q.unemployed_dem += 5;
        Q.rural_dem += 4;
        Q.middle_class_dem -= 3;
        Q.immigrant_laborers_dem += 3;
        Q.inflation += 0.25;
    }
}
!}
go-to: dem_convention_end_76

@dem_convention_end_76

= The <span style="color: #0015bc;">**Democrats**</span> Have Chosen

[? if dem_candidate_1876 = "Tilden" : <div class="face-figure"><img src="img/portraits/Samuel_Tilden._Portrait_of_the_American_politician,_who_served_as_the_25th_Governor_of_New_York,_Samuel_Jones_Tilden_(1814-1886),_by_José_María_Mora,_c._1870.jpg" alt="Samuel Tilden" class="face-img"></div> ?][? if dem_candidate_1876 = "Hendricks" : <div class="face-figure"><img src="img/portraits/Thomas_Andrews_Hendricks,_photo_portrait_seated,_1860-65.jpg" alt="Samuel Tilden" class="face-img"></div> ?][? if dem_candidate_1876 = "Bayard" : <div class="face-figure"><img src="img/portraits/960px-Thomas_F._Bayard,_Brady-Handy_photo_portrait,_circa_1870-1880_(cropped)(b).jpg" alt="Thomas Bayard" class="face-img"></div> ?][? if dem_candidate_1876 = "Hancock" : <div class="face-figure"><img src="img/portraits/Gen._Winfield_S._Hancock_-_NARA_-_529369_(cropped,_retouched).jpg" alt="Winfield Hancock" class="face-img"></div> ?][? if dem_candidate_1876 = "Allen" : <div class="face-figure"><img src="img/portraits/William_Allen_governor_-_Brady-Handy.jpg" alt="William Allen" class="face-img"></div> ?]

[? if dem_reform_dominant_76 = 1 : The <span style="color: #4682B4;">**Northern Democrats**</span> carry the convention. Samuel J. Tilden is nominated for President with [+ dem_vp_candidate_1876 +] for Vice President. The ticket will make Republican corruption its central issue. ?]

[? if dem_reform_dominant_76 = 0 : The <span style="color: #002765;">**Bourbon Democrats**</span> prevail. [+ dem_candidate_1876 +] is nominated for President with [+ dem_vp_candidate_1876 +] for Vice President. The ticket will campaign on Redemption and home rule in the South. ?]

[? if dem_candidate_1876 = "Tilden" : Tilden's record against the Tweed Ring gives the <span style="color: #4682B4;">**reformers**</span> a strong candidate in the North, though Southern <span style="color: #002765;">**Bourbons**</span> remain wary of his position on Reconstruction. ?]

[? if dem_candidate_1876 = "Hendricks" : Hendricks' soft-money views and ties to the <span style="color: #002765;">**Bourbon Democrats**</span> make him a reliable choice for the Redeemer cause, though hard-money <span style="color: #4682B4;">**reformers**</span> in the Northeast are dissatisfied. ?]

[? if dem_candidate_1876 = "Bayard" : Bayard's hard-money views and deep ties to the <span style="color: #002765;">**Bourbon Democrats**</span> make him a safe choice for the party establishment, though he has little appeal among working-class <span style="color: #0015bc;">**Democrats**</span>. ?]

[? if dem_candidate_1876 = "Hancock" : Hancock's Civil War record gives the <span style="color: #002765;">**Bourbon**</span> ticket an answer to Republican attacks on Democratic loyalty. ?]

[? if dem_candidate_1876 = "Allen" : Allen's Greenback sympathies appeal to debtors and laborers, while hard-money <span style="color: #4682B4;">**Democrats**</span> threaten to stay home in November. ?]

[? if dem_reform_dominant_76 = 0 : The <span style="color: #4682B4;">**reformers**</span> are furious with the outcome. Some threaten to withhold their support from the fall campaign. ?]

[? if dem_reform_dominant_76 = 1 : The <span style="color: #002765;">**Bourbon**</span> wing is furious with the outcome, and Southern Redeemer newspapers have begun attacking the ticket. ?]