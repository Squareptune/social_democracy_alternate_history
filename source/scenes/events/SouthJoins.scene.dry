title: Southern State Readmitted
subtitle: Congressional Reconstruction Advances
tags: event
view-if: reconstructionPlanActive = 1 and ((VA_canReadmit = 1 and VA_admitted = 0) or (NC_canReadmit = 1 and NC_admitted = 0) or (SC_canReadmit = 1 and SC_admitted = 0) or (GA_canReadmit = 1 and GA_admitted = 0) or (AL_canReadmit = 1 and AL_admitted = 0) or (FL_canReadmit = 1 and FL_admitted = 0) or (MS_canReadmit = 1 and MS_admitted = 0) or (AR_canReadmit = 1 and AR_admitted = 0) or (TX_canReadmit = 1 and TX_admitted = 0) or (LA_canReadmit = 1 and LA_admitted = 0))
on-arrival: {!
Q.readmitted_list = "";

// Virginia
if (Q.VA_canReadmit === 1 && Q.VA_admitted === 0) {
    Q.states.push("VA");
    Q.VA_admitted = 1;
    Q.readmitted_list += "Virginia";
    if(Q.Radical_plan == 1)
    {
        Q.Radical_plan_Count += 1;
    }
    if(Q.year < 1870)
    {
        Q.Carpetbagger_Supreme += 1;
    }
}

