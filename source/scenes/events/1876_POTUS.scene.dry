title: 1876 Presidential Election
subtitle: [+ Candidate +] vs. [+ dem_candidate_1876 +]
tags: event
view-if: year = 1876 and month = 11
max-visits: 1

= Elections, [+ month +] [+ year +]

The Presidential election is to be held now. <span style="color: #c00000;">**Republicans**</span> and <span style="color: #0015bc;">**Democrats**</span> face off in a straight two-party contest, the closest since the war began.

- @POTUS_election_algorithm_1876: May we do our best...

@POTUS_election_algorithm_1876
on-arrival: {!
Q.repEVTotal = 0;
Q.demEVTotal = 0;
Q.disputedRepEV = 0;
Q.disputedDemEV = 0;

Q.disputed_states_1876 = [];

let southernCodes = ["VA", "NC", "SC", "GA", "AL", "FL", "MS", "AR", "TX", "LA"];

let closeStates = {
  "VT":  75.00,
  "MA":  68.00,
  "RI":  67.00,
  "KS":  62.00,
  "NE":  65.00,
  "ME":  56.00,
  "NH":  49.00,
  "MN":  58.00,
  "MI":  59.00,
  "IA":  57.00,
  "IL":  53.00,
  "WI":  50.00,
  "OH":  50.50,
  "IN":  49.30,
  "PA":  50.60,
  "NV":  53.00,
  "CA":  51.00,
  "OR":  50.90,
  "CT":  48.80,
  "NJ":  47.90,
  "NY":  48.30,
  "WV":  46.50,
  "KY":  -30.00,
  "MD":  -34.00,
  "DE":  -24.00,
  "MO":  -32.00
};

let baselineRep = 53;
let baselineDem = 44;
let nationalRepSwing = (Q.workers_rep + Q.middle_class_rep + Q.rural_rep + Q.freemen_rep + Q.immigrant_laborers_rep + Q.unemployed_rep) / 6 - baselineRep;
let nationalDemSwing = (Q.workers_dem + Q.middle_class_dem + Q.rural_dem + Q.freemen_dem + Q.immigrant_laborers_dem + Q.unemployed_dem) / 6 - baselineDem;

let candidateNorthShift = {
  "Tilden":    -3.5,
  "Hendricks": -1.5,
  "Bayard":     1.0,
  "Hancock":    0,
  "Allen":     -1.0
}[Q.dem_candidate_1876] || 0;

for (let state of Q.states) {
  let votes = { rep: 0, dem: 0 };
  let isSouthern = southernCodes.includes(state);

  let planThreshold = Q.Radical_plan ? 50 : (Q.Moderate_plan ? 35 : 20);
  let stateScore = Q[state + "_reconstructionScore"] || 0;
  let badReconstruction = isSouthern && (stateScore < planThreshold * 0.6 || ((Q.kkk_strength || 0) + (Q.whiteL_strength || 0)) >= 300);

  for (let cls of Q.classes) {
    if (cls === "freemen" && Q.fifthteen == 0) continue;

    let pop = Q[state + "_" + cls] || 0;

    if (cls === "freemen") {
      let localTurnout = Q.freedmen_turnout;
      if (badReconstruction) localTurnout = localTurnout * 0.4;
      pop = pop * (localTurnout / 100);
    }

    if (pop <= 0) continue;

    let localRep = Q[state + "_" + cls + "_rep"] || 0;
    let localDem = Q[state + "_" + cls + "_dem"] || 0;
    let nationalRep = Q[cls + "_rep"] || 0;
    let nationalDem = Q[cls + "_dem"] || 0;

    let adjRep = 0.5 * localRep + 0.5 * nationalRep;
    let adjDem = 0.5 * localDem + 0.5 * nationalDem;

    adjRep = Math.max(0, adjRep + nationalRepSwing * 0.3);
    adjDem = Math.max(0, adjDem + nationalDemSwing * 0.3);

    adjRep *= (0.92 + Math.random() * 0.16);
    adjDem *= (0.92 + Math.random() * 0.16);

    let total = adjRep + adjDem;
    if (!total) continue;

    votes.rep += pop * (adjRep / total);
    votes.dem += pop * (adjDem / total);
  }

  if (!isSouthern && closeStates[state] !== undefined) {
    let nudge = closeStates[state] * 0.1 + candidateNorthShift;
    let randomJitter = (Math.random() * 0.8) - 0.4;
    let marginTarget = nudge + randomJitter;

    let twoPartyTotal = votes.rep + votes.dem;
    if (twoPartyTotal > 0) {
      let currentMargin = ((votes.rep - votes.dem) / twoPartyTotal) * 100;
      let marginDiff = marginTarget - currentMargin;
      votes.rep += twoPartyTotal * (marginDiff / 200);
      votes.dem -= twoPartyTotal * (marginDiff / 200);
      votes.rep = Math.max(0, votes.rep);
      votes.dem = Math.max(0, votes.dem);
    }
  }

  let stateDisputed = 0;

  if (badReconstruction) {
    let twoPartyTotal = votes.rep + votes.dem;
    if (twoPartyTotal > 0) {
      let currentMargin = ((votes.rep - votes.dem) / twoPartyTotal) * 100;
      
      let fraudPower = Math.min(35, ((Q.kkk_strength || 0) + (Q.whiteL_strength || 0)) / 20);
      let fraudShift = fraudPower + (Math.random() * 10) - 5;

      votes.rep -= twoPartyTotal * (fraudShift / 200);
      votes.dem += twoPartyTotal * (fraudShift / 200);
      votes.rep = Math.max(0, votes.rep);
      votes.dem = Math.max(0, votes.dem);

      let postFraudMargin = ((votes.rep - votes.dem) / twoPartyTotal) * 100;
      
      if (Math.abs(postFraudMargin) <= 14) {
        stateDisputed = 1;
        Q.disputed_states_1876.push(state);
      }
      
      if ((Q.kkk_strength || 0) + (Q.whiteL_strength || 0) >= 400) {
        if (Math.random() < 0.5) {
          stateDisputed = 1;
          if (!Q.disputed_states_1876.includes(state)) {
            Q.disputed_states_1876.push(state);
          }
        }
      }
    }
  }

  let winner = votes.dem >= votes.rep ? "dem" : "rep";
  Q[state + "_winner"] = winner;
  Q[state + "_disputed_1876"] = stateDisputed;

  let color = winner === "dem" ? "#4575b4" : "#d73027";
  if (stateDisputed) color = "#8E536E";
  Q[state.toLowerCase() + "_winner_color"] = color;
}

for (let state of Q.states) {
  let ev = Q[state + "_EV_1876"];
  if (!ev) continue;

  let w = Q[state + "_winner"];
  let disputed = Q[state + "_disputed_1876"];

  if (w === "rep") Q.repEVTotal += ev;
  else Q.demEVTotal += ev;

  if (disputed) {
    if (w === "rep") Q.disputedRepEV += ev;
    else Q.disputedDemEV += ev;
  }
}

let totalEV = Q.repEVTotal + Q.demEVTotal;
let majority = Math.floor(totalEV / 2) + 1;

let repUndisputed = Q.repEVTotal - Q.disputedRepEV;
let demUndisputed = Q.demEVTotal - Q.disputedDemEV;

if (Q.disputed_states_1876.length > 0 && repUndisputed < majority && demUndisputed < majority) {
  Q.potus_winner = "disputed";
} else if (Q.repEVTotal >= majority) {
  Q.potus_winner = "rep";
} else {
  Q.potus_winner = "dem";
}

if(Q.demEVTotal == 0 && Q.libEVTotal == 0)
{
  this.achieve("washington");
}

!}
on-display: {!
  var winners = {
    al: Q.al_winner_color,
    ar: Q.ar_winner_color,
    ca: Q.ca_winner_color,
    co: Q.co_winner_color,
    ct: Q.ct_winner_color,
    de: Q.de_winner_color,
    fl: Q.fl_winner_color,
    ga: Q.ga_winner_color,
    il: Q.il_winner_color,
    in: Q.in_winner_color,
    ia: Q.ia_winner_color,
    ks: Q.ks_winner_color,
    ky: Q.ky_winner_color,
    la: Q.la_winner_color,
    me: Q.me_winner_color,
    md: Q.md_winner_color,
    ma: Q.ma_winner_color,
    mi: Q.mi_winner_color,
    mn: Q.mn_winner_color,
    ms: Q.ms_winner_color,
    mo: Q.mo_winner_color,
    ne: Q.ne_winner_color,
    nv: Q.nv_winner_color,
    nh: Q.nh_winner_color,
    nj: Q.nj_winner_color,
    ny: Q.ny_winner_color,
    nc: Q.nc_winner_color,
    oh: Q.oh_winner_color,
    or: Q.or_winner_color,
    pa: Q.pa_winner_color,
    ri: Q.ri_winner_color,
    sc: Q.sc_winner_color,
    tn: Q.tn_winner_color,
    tx: Q.tx_winner_color,
    vt: Q.vt_winner_color,
    va: Q.va_winner_color,
    wv: Q.wv_winner_color,
    wi: Q.wi_winner_color,
    dc: Q.dc_winner_color,
  };
 
  let results = {};
  for (let state of Q.states) {
    let key = state.toLowerCase();
    let entry = {
      "Republican": Q[state + "_rep_pct"] || 0,
      "Democratic": Q[state + "_dem_pct"] || 0,
    };
    if (Q.liberal_split && (Q[state + "_lib_pct"] || 0) > 0) {
      entry["Liberal Republican"] = Q[state + "_lib_pct"];
    }
    results[key] = entry;
  }
 
  function drawMap() {
    ElectoralMap.draw({ container: "#electoral-map", winners: winners, results: results });
  }
 
  if (typeof ElectoralMap !== 'undefined') {
    drawMap();
  } else {
    var script = document.createElement('script');
    script.src = 'electoral-map.js';
    script.onload = drawMap;
    document.head.appendChild(script);
  }
!}
 
